# ── Google OAuth (required for sign-in) ──────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Add your domain to Authorized JavaScript origins
# Looks like: xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Random 64+ character string for signing session JWTs
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ── Map API Tokens ───────────────────────────────────────────────────────────
# Cesium ion access token (3D globe)
# Get from: https://ion.cesium.com/tokens (free tier available)
CESIUM_ION_TOKEN=

# Mapillary API tokens (street-level imagery) — comma-separated for rotation
# Get from: https://www.mapillary.com/developer (free tier available)
MAPILLARY_TOKENS=

# MapTiler API token (map tiles)
# Get from: https://cloud.maptiler.com/account/keys (free tier available)
MAPTILER_TOKEN=

# ── Upstash Redis (KV store for user data + OSM cache) ───────────────────────
# Get from: https://console.upstash.com/ (free tier available)
# Create a Redis database, copy the REST API URL and token
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Admin ────────────────────────────────────────────────────────────────────
# Secret for OSM cache write endpoint (32+ characters)
# Generate with: openssl rand -base64 32
ADMIN_SECRET=

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
# Your production domain + localhost for development
CORS_ORIGINS=http://localhost:3000
